# ─────────────────────────────────────────────────────────────────────────────
# UniRide — Frontend environment variables
# Copia este archivo como .env.local y edita los valores
# ─────────────────────────────────────────────────────────────────────────────

# URL base del backend Laravel (sin /api al final)
VITE_API_URL=http://localhost:8000/api

# Activar integración con el backend real
# false = modo demo/mock (no necesita backend corriendo)
# true  = usa el backend Laravel
VITE_USE_BACKEND=false

# ── EmailJS (para envío real de OTP por correo) ───────────────────────────────
# Deja vacío para usar el modo consola (F12)
VITE_EMAILJS_SERVICE_ID
VITE_EMAILJS_TEMPLATE_ID
VITE_EMAILJS_PUBLIC_KEY
